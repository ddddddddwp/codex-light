{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"],
    "outDir": "dist-types/node"
  },
  "include": [
    "src/core/**/*.ts",
    "src/hook-cli/**/*.ts",
    "src/main/**/*.ts",
    "tests/**/*.ts",
    "*.config.ts",
    "eslint.config.js"
  ]
}
